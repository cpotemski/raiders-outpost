generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  token     String   @unique
  activeExpeditionSlug String?
  expeditionResetDismissedCycle String?
  expeditionResetCompletedCycle String?
  projectItems UserProjectItem[]
  communityMemberships CommunityMember[]
  authCodes AuthCode[]
  createdAt DateTime @default(now())
}

model Project {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  stages    ProjectStage[]
  createdAt DateTime @default(now())
}

model ProjectStage {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  sortOrder Int
  items     ProjectItem[]

  @@unique([projectId, sortOrder])
}

model ProjectItem {
  id               String   @id @default(uuid())
  stage            ProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageId          String
  itemName         String
  quantityRequired Int
  userProgress     UserProjectItem[]

  @@unique([stageId, itemName])
}

model UserProjectItem {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  projectItem   ProjectItem @relation(fields: [projectItemId], references: [id], onDelete: Cascade)
  projectItemId String
  quantityOwned Int      @default(0)

  @@unique([userId, projectItemId])
}

model Community {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  members    CommunityMember[]
  createdAt  DateTime @default(now())
}

model CommunityMember {
  id          String    @id @default(uuid())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  joinedAt    DateTime  @default(now())

  @@unique([communityId, userId])
}

model AuthCode {
  id        String   @id @default(uuid())
  code      String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AdminSettings {
  id                   String   @id @default("global")
  disabledProjectSlugs String[] @default([])
  disabledItemIds      String[] @default([])
  updatedAt            DateTime @updatedAt
}
